# OpportunityKit Frontend Environment Variables
# NOTE: All NEXT_PUBLIC_* variables are embedded at build time.
# If you change these variables in Vercel, you must trigger a redeployment!

# HTTPS URL of the deployed Render backend service (leave blank or http://localhost:5000 for local dev)
NEXT_PUBLIC_API_URL=https://opportunitykit-backend.onrender.com

# Supabase Auth & Cloud sync (optional for local/demo, required for cloud sync)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
